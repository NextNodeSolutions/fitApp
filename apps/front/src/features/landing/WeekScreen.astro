---
import { CALORIE_STATUS_LABELS } from '@fitapp/contracts'
import { badgeVariants } from '@fitapp/ui'

import { formatNumber } from '../../lib/format/format-number'

import AssistantReply from './AssistantReply.astro'
import ChatHeader from './ChatHeader.astro'
import { DEMO_TARGET_KCAL, DEMO_WEEK, DEMO_WEEK_STATS } from './demo-data'
import ToolResult from './ToolResult.astro'
import UserBubble from './UserBubble.astro'
import WeekBarChart from './WeekBarChart.astro'

const { averageKcal, balancedDays, loggedDays } = DEMO_WEEK_STATS
const stats = [
	{ label: 'Moyenne', value: formatNumber(averageKcal), unit: 'kcal' },
	{
		label: CALORIE_STATUS_LABELS.balance,
		value: `${balancedDays}/${loggedDays}`,
		unit: 'jours',
	},
	{ label: 'Poids', value: formatNumber(DEMO_WEEK.weightDeltaKg), unit: 'kg' },
]
---

<ChatHeader time="dim. 21:04" />
<UserBubble>Comment s'est passée ma semaine&nbsp;?</UserBubble>
<AssistantReply>
	Belle semaine&nbsp;! Tu es resté proche de ta cible{' '}
	{balancedDays} jours sur {loggedDays}, et tes protéines
	progressent.
</AssistantReply>
<ToolResult title="ta semaine" meta={DEMO_WEEK.range}>
	<dl class="grid grid-cols-3 gap-2 pt-3">
		{
			stats.map(stat => (
				<div>
					<dt class="text-[11px] text-muted-foreground">{stat.label}</dt>
					<dd class="mt-0.5 text-lg leading-tight font-medium tabular-nums">
						{stat.value}{' '}
						<span class="text-[11px] font-normal text-muted-foreground">
							{stat.unit}
						</span>
					</dd>
				</div>
			))
		}
	</dl>
	<WeekBarChart days={DEMO_WEEK.days} targetKcal={DEMO_TARGET_KCAL} />
	<div
		class="mt-3 flex items-center justify-between border-t border-border pt-2.5 text-[13px]"
	>
		<span>Protéines</span>
		<span class="flex items-center gap-2">
			<span class="tabular-nums">{DEMO_WEEK.proteinPerDayG} g/jour</span>
			<span class={badgeVariants({ tone: 'positive' })}>
				+{DEMO_WEEK.proteinDeltaG} g
			</span>
		</span>
	</div>
</ToolResult>
