---
import { buildDaySummary } from '@fitapp/contracts'
import { Progress } from '@fitapp/ui'

import CalorieStatusBadge from '../../components/nutrition/CalorieStatusBadge.astro'
import { formatNumber } from '../../lib/format/format-number'
import { MACRO_TONES } from '../../lib/macro-tones'
import { WEEKDAY_LETTERS } from '../../lib/weekday-letters'

import {
	DEMO_DAY,
	DEMO_TARGET_KCAL,
	DEMO_WEIGHT_KG,
} from './demo-data'

const summary = buildDaySummary(
	DEMO_TARGET_KCAL,
	DEMO_WEIGHT_KG,
	DEMO_DAY.meals,
)
---

<div class="flex items-baseline justify-between px-1">
	<span class="text-[15px] font-semibold">Aujourd'hui</span>
	<span class="text-xs text-muted-foreground">{DEMO_DAY.label}</span>
</div>
<ol class="mt-3 grid grid-cols-7 gap-1">
	{
		WEEKDAY_LETTERS.map((letter, index) => (
			<li
				data-tile={index < DEMO_DAY.todayIndex ? '' : undefined}
				class:list={[
					'grid place-items-center rounded-xl py-1.5 text-[11px] font-medium',
					index === DEMO_DAY.todayIndex && 'bg-foreground text-background',
					index < DEMO_DAY.todayIndex && 'bg-background',
					index > DEMO_DAY.todayIndex && 'text-muted-foreground',
				]}
			>
				{letter}
			</li>
		))
	}
</ol>
<div data-tile class="mt-2.5 rounded-2xl bg-background p-3.5">
	<div class="flex items-center justify-between text-xs text-muted-foreground">
		<span>Calories</span>
		<CalorieStatusBadge status={summary.status} />
	</div>
	<p class="mt-1.5 flex items-baseline gap-1.5">
		<span class="text-4xl font-medium tracking-[-0.05em] tabular-nums">
			{formatNumber(summary.consumed.calories)}
		</span>
		<span class="text-sm text-muted-foreground">
			/ {formatNumber(summary.targetKcal)} kcal
		</span>
	</p>
	<Progress
		value={summary.consumed.calories / summary.targetKcal}
		label="Calories consommées par rapport à la cible"
		size="lg"
		tone={summary.status === 'surplus' ? 'warning' : 'brand'}
		className="mt-3"
	/>
	<p class="mt-2 text-xs text-muted-foreground">{summary.remainingMessage}</p>
</div>
<ul class="mt-2 grid grid-cols-3 gap-2">
	{
		summary.macros.map(macro => (
			<li data-tile class="rounded-2xl bg-background p-2.5">
				<span class="text-[11px] text-muted-foreground">{macro.label}</span>
				<p class="mt-0.5 text-lg leading-tight font-medium tabular-nums">
					{formatNumber(macro.consumedG)} g
				</p>
				<p class="text-[11px] text-muted-foreground">
					sur {formatNumber(macro.targetG)} g
				</p>
				<Progress
					value={macro.consumedG / macro.targetG}
					label={macro.label}
					size="sm"
					tone={MACRO_TONES[macro.key]}
					className="mt-2"
				/>
			</li>
		))
	}
</ul>
<ul data-tile class="mt-2 rounded-2xl bg-background px-3 py-0.5">
	{
		DEMO_DAY.meals.map(meal => (
			<li class="flex items-center gap-3 border-b border-border py-2 text-[13px] last:border-0">
				<span class="font-mono text-[11px] text-muted-foreground">
					{meal.time}
				</span>
				<span class="min-w-0 flex-1 truncate">{meal.name}</span>
				<span class="tabular-nums">{meal.calories}</span>
			</li>
		))
	}
</ul>
