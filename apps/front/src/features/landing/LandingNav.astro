---
import { buttonVariants, cn } from '@fitapp/ui'

import Wordmark from '../../components/brand/Wordmark.astro'
import NavLink from '../../components/navigation/NavLink.astro'
import { ROUTES } from '../../lib/routes'

import { LANDING_SECTIONS } from './landing-sections'

const MENU_ID = 'landing-menu'
---

<header
	data-landing-nav
	class="group fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[translate,background-color,border-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] data-[hidden]:-translate-y-full data-[open]:border-border data-[open]:bg-background data-[scrolled]:border-border data-[scrolled]:bg-background/85 data-[scrolled]:backdrop-blur-lg"
>
	<div
		class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8"
	>
		<Wordmark />
		<nav aria-label="Sections" class="hidden items-center gap-8 md:flex">
			{
				LANDING_SECTIONS.map(section => (
					<NavLink href={`#${section.id}`}>{section.label}</NavLink>
				))
			}
		</nav>
		<div class="flex items-center gap-6">
			<NavLink href={ROUTES.login} class="hidden md:inline-flex">
				Connexion
			</NavLink>
			<a
				href={ROUTES.signup}
				class={cn(
					buttonVariants({ variant: 'dark', size: 'sm' }),
					'hidden md:inline-flex',
				)}
			>
				Commencer
			</a>
			<button
				type="button"
				data-menu-toggle
				aria-expanded="false"
				aria-controls={MENU_ID}
				aria-label="Menu"
				class="-mr-2 grid size-11 place-items-center md:hidden"
			>
				<span class="relative block h-3 w-5" aria-hidden="true">
					<span
						class="absolute inset-x-0 top-0 h-[1.5px] rounded-full bg-foreground transition-transform duration-300 group-data-[open]:translate-y-[5px] group-data-[open]:rotate-45"
					></span>
					<span
						class="absolute inset-x-0 bottom-0 h-[1.5px] rounded-full bg-foreground transition-transform duration-300 group-data-[open]:-translate-y-[5px] group-data-[open]:-rotate-45"
					></span>
				</span>
			</button>
		</div>
	</div>
	<div
		id={MENU_ID}
		data-menu
		inert
		class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-data-[open]:grid-rows-[1fr] md:hidden"
	>
		<div class="overflow-hidden">
			<nav
				aria-label="Menu"
				class="flex flex-col gap-1 px-4 pt-2 pb-6 sm:px-6"
			>
				{
					LANDING_SECTIONS.map(section => (
						<a
							href={`#${section.id}`}
							class="py-3 text-2xl font-medium tracking-[-0.03em]"
						>
							{section.label}
						</a>
					))
				}
				<a
					href={ROUTES.login}
					class="py-3 text-2xl font-medium tracking-[-0.03em]"
				>
					Connexion
				</a>
				<a
					href={ROUTES.signup}
					class={cn(buttonVariants({ size: 'lg' }), 'mt-4 w-full')}
				>
					Commencer
				</a>
			</nav>
		</div>
	</div>
</header>

<script>
	import { initLandingNav } from './init-landing-nav'

	initLandingNav()
</script>
