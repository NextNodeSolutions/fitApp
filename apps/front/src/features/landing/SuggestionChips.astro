---
interface Props {
	suggestions: readonly string[]
}

const { suggestions } = Astro.props
---

<ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Suggestions">
	{
		suggestions.map(suggestion => (
			<li class="rounded-full border border-border bg-background px-3 py-1.5 text-[13px]">
				{suggestion}
			</li>
		))
	}
</ul>
