---
import { formatStepNumber } from './format-step-number'

interface Props {
	count: number
}

const { count } = Astro.props
const dots = Array.from({ length: count }, (_, index) => formatStepNumber(index))
---

<div class="sticky top-0 flex h-svh flex-col items-center justify-center gap-5">
	<div
		class="relative aspect-[340/690] h-[min(690px,calc(100svh-7rem))] overflow-hidden rounded-[54px] border-[11px] border-foreground bg-background shadow-[0_40px_80px_-40px_rgba(11,14,12,0.45)] [&_[data-bubble]]:bg-card [&_[data-tile]]:bg-card"
	>
		<span
			class="absolute top-2.5 left-1/2 z-10 h-[30px] w-[104px] -translate-x-1/2 rounded-full bg-foreground"
		></span>
		<slot />
	</div>
	<ol class="flex gap-1.5">
		{
			dots.map((dot, index) => (
				<li
					data-phone-step={index}
					data-active={index === 0 ? '' : undefined}
					class="rounded-full bg-card px-2.5 py-1.5 font-mono text-[11px] text-muted-foreground transition-colors duration-300 data-[active]:bg-foreground data-[active]:text-background"
				>
					{dot}
				</li>
			))
		}
	</ol>
</div>
