---
import { APP_NAME } from '@fitapp/contracts'

interface Props {
	title: string
	meta: string
}

const { title, meta } = Astro.props
---

<div class="mt-3 rounded-2xl border border-border bg-background p-3">
	<div
		class="flex items-center justify-between gap-3 border-b border-border pb-2 font-mono text-[11px] text-muted-foreground"
	>
		<span class="inline-flex items-center gap-1.5 text-foreground">
			<span class="size-1.5 rounded-full bg-brand" aria-hidden="true"></span>
			{APP_NAME} · {title}
		</span>
		<span>{meta}</span>
	</div>
	<slot />
</div>
