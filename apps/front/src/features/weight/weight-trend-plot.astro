---
import { formatEntryDate } from './format-entry-date'
import { formatWeight } from './format-weight'

import type { WeightTrend } from './build-weight-trend'

type Props = {
	trend: WeightTrend
	unitLabel: string
}

const { trend, unitLabel } = Astro.props
const { start, latest, minWeight, maxWeight, latestPoint } = trend
const isFlat = minWeight === maxWeight
const summary = `Évolution du poids du ${formatEntryDate(start.entryDate, 'long')} au ${formatEntryDate(latest.entryDate, 'long')} : de ${formatWeight(start.weight, unitLabel)} à ${formatWeight(latest.weight, unitLabel)}, entre ${formatWeight(minWeight, unitLabel)} et ${formatWeight(maxWeight, unitLabel)}.`
---

<div class="mt-6 grid grid-cols-[minmax(0,1fr)_auto] gap-x-3 gap-y-3">
	<div class="relative h-36 sm:h-44">
		<svg
			viewBox="0 0 100 100"
			preserveAspectRatio="none"
			class="absolute inset-0 size-full overflow-visible"
			role="img"
			aria-label={summary}
		>
			<defs>
				<linearGradient id="weight-trend-fill" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" style="stop-color: var(--brand); stop-opacity: 0.24"
					></stop>
					<stop offset="1" style="stop-color: var(--brand); stop-opacity: 0"
					></stop>
				</linearGradient>
			</defs>
			<path d={trend.areaPath} fill="url(#weight-trend-fill)"></path>
			<line
				x1="0"
				y1="100"
				x2="100"
				y2="100"
				class="stroke-input"
				stroke-width="1"
				stroke-dasharray="4 4"
				vector-effect="non-scaling-stroke"></line>
			<path
				d={trend.linePath}
				fill="none"
				class="stroke-brand-ink"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				vector-effect="non-scaling-stroke"></path>
		</svg>
		<span
			aria-hidden="true"
			class="absolute size-2.5 -translate-1/2 rounded-full bg-brand-ink ring-4 ring-brand-soft"
			style={`left: ${latestPoint.x}%; top: ${latestPoint.y}%`}></span>
	</div>
	<div
		aria-hidden="true"
		class:list={[
			'-my-2 flex flex-col font-mono text-xs leading-4 whitespace-nowrap text-muted-foreground',
			isFlat ? 'justify-center' : 'justify-between',
		]}
	>
		<span>{formatWeight(maxWeight, unitLabel)}</span>
		{isFlat ? null : <span>{formatWeight(minWeight, unitLabel)}</span>}
	</div>
	<div
		aria-hidden="true"
		class="flex justify-between font-mono text-xs text-muted-foreground"
	>
		<span>{formatEntryDate(start.entryDate, 'short')}</span>
		<span>{formatEntryDate(latest.entryDate, 'short')}</span>
	</div>
</div>
