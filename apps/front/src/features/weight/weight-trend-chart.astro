---
import { Badge, Card, CardTitle } from '@fitapp/ui'

import { buildWeightTrend } from './build-weight-trend'
import { formatEntryDate } from './format-entry-date'
import { formatWeight } from './format-weight'
import { formatWeightDelta } from './format-weight-delta'
import WeightTrendPlot from './weight-trend-plot.astro'

import type { DisplayWeightEntry } from './display-weight-entry'

type Props = {
	/** Newest first, as the API returns them. */
	entries: readonly DisplayWeightEntry[]
	unitLabel: string
}

const { entries, unitLabel } = Astro.props
const [latest] = entries
const trend = buildWeightTrend(entries)
const missingDataHint = latest
	? 'Ajoute une deuxième pesée pour voir ta tendance.'
	: 'Ajoute ta première pesée pour voir ta tendance.'
---

<Card>
	<CardTitle>Tendance</CardTitle>
	{
		latest ? (
			<p class="mt-3 text-4xl font-medium tracking-tight tabular-nums">
				{formatWeight(latest.weight, unitLabel)}
			</p>
		) : null
	}
	{
		trend ? (
			<>
				<p class="mt-2 flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
					<Badge>{formatWeightDelta(trend.delta, unitLabel)}</Badge>
					depuis le {formatEntryDate(trend.start.entryDate, 'long')}
				</p>
				<WeightTrendPlot trend={trend} unitLabel={unitLabel} />
			</>
		) : (
			<p class="mt-2 text-sm text-muted-foreground">{missingDataHint}</p>
		)
	}
</Card>
