---
import { Card, CardDescription, CardTitle } from '@fitapp/ui'

import { formatEntryDate } from './format-entry-date'
import { formatWeight } from './format-weight'

import type { DisplayWeightEntry } from './display-weight-entry'

type Props = {
	/** Newest first, as the API returns them. */
	entries: readonly DisplayWeightEntry[]
	unitLabel: string
}

const MAX_HISTORY_ROWS = 10

const { entries, unitLabel } = Astro.props
const shownEntries = entries.slice(0, MAX_HISTORY_ROWS)
---

<Card>
	<CardTitle>Historique</CardTitle>
	<CardDescription className="mt-1">Tes dernières pesées</CardDescription>
	{
		shownEntries.length ? (
			<ul class="mt-3 divide-y divide-secondary">
				{shownEntries.map(entry => (
					<li class="flex min-h-12 items-center justify-between gap-4 py-3 text-[15px]">
						<span class="text-muted-foreground">
							{formatEntryDate(entry.entryDate, 'long')}
						</span>
						<span class="font-medium whitespace-nowrap tabular-nums">
							{formatWeight(entry.weight, unitLabel)}
						</span>
					</li>
				))}
			</ul>
		) : (
			<p class="mt-4 text-sm text-muted-foreground">
				Aucune pesée enregistrée sur cette période.
			</p>
		)
	}
</Card>
