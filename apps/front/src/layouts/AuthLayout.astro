---
import Wordmark from '../components/brand/Wordmark.astro'
import ResponsivePhoto from '../components/media/ResponsivePhoto.astro'

import BaseLayout from './BaseLayout.astro'

interface Props {
	title: string
	heading: string
	intro: string
	/** Link to the other auth page, under the form. */
	switchTo?: { prompt: string; href: string; label: string }
}

const { title, heading, intro, switchTo } = Astro.props
---

<BaseLayout title={title}>
	<div
		class="grid min-h-svh lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]"
	>
		<div class="flex flex-col px-5 pt-5 pb-12 sm:px-10">
			<Wordmark />
			<main
				class="mx-auto flex w-full max-w-[420px] flex-1 flex-col justify-center pt-12"
			>
				<h1
					class="text-[2.5rem] leading-[1.02] font-medium tracking-[-0.04em] sm:text-5xl"
				>
					{heading}
				</h1>
				<p class="mt-3 text-muted-foreground">{intro}</p>
				<div class="mt-9">
					<slot />
				</div>
				{
					switchTo ? (
						<p class="mt-8 text-[15px] text-muted-foreground">
							{switchTo.prompt}{' '}
							<a
								href={switchTo.href}
								class="inline-flex min-h-11 items-center font-medium text-foreground underline decoration-foreground/30 underline-offset-4 transition-colors hover:decoration-foreground"
							>
								{switchTo.label}
							</a>
						</p>
					) : null
				}
			</main>
		</div>
		<div class="sticky top-0 hidden h-svh p-3 lg:block">
			<ResponsivePhoto
				name="band-park"
				alt=""
				sizes="50vw"
				class="rounded-[28px] object-[60%_center]"
			/>
		</div>
	</div>
</BaseLayout>
