---
import { CALORIE_STATUS_LABELS } from '@fitapp/contracts'
import { Badge } from '@fitapp/ui'

import type { CalorieStatus } from '@fitapp/contracts'

interface Props {
	status: CalorieStatus
}

const { status } = Astro.props
---

<Badge tone={status === 'surplus' ? 'warning' : 'positive'}>
	{CALORIE_STATUS_LABELS[status]}
</Badge>
