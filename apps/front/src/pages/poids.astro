---
import { env } from 'cloudflare:workers'

import {
	DEFAULT_WEIGHT_PERIOD,
	todayIsoDate,
	WEIGHT_PERIODS,
	WEIGHT_PERIOD_OPTIONS,
	weightUnitLabel,
} from '@fitapp/contracts'
import {
	cn,
	segmentedControlItemVariants,
	segmentedControlVariants,
} from '@fitapp/ui'

import { fetchSettingsProfile } from '../features/settings/fetch-settings-profile'
import { fetchWeightEntries } from '../features/weight/fetch-weight-entries'
import { toDisplayWeightEntries } from '../features/weight/to-display-weight-entries'
import { WeightEntryForm } from '../features/weight/WeightEntryForm'
import WeightHistory from '../features/weight/weight-history.astro'
import WeightTrendChart from '../features/weight/weight-trend-chart.astro'
import AppLayout from '../layouts/AppLayout.astro'
import { ROUTES } from '../lib/routes'

const userId = Astro.locals.user?.id ?? null
const requestedPeriod = Astro.url.searchParams.get('period')
const period =
	WEIGHT_PERIODS.find(candidate => candidate === requestedPeriod) ??
	DEFAULT_WEIGHT_PERIOD

const [profile, entries] = await Promise.all([
	fetchSettingsProfile(env, userId),
	fetchWeightEntries(env, userId, period),
])
const units = profile?.units ?? 'metric'
const displayEntries = toDisplayWeightEntries(entries, units)
const unitLabel = weightUnitLabel(units)

const todayEntry = displayEntries.find(
	entry => entry.entryDate === todayIsoDate(),
)
const todayWeightDisplay = todayEntry ? String(todayEntry.weight) : undefined
---

<AppLayout title="Poids" current="weight">
	<div
		class="mb-6 flex flex-col gap-5 sm:mb-8 sm:flex-row sm:items-end sm:justify-between"
	>
		<div>
			<h1 class="text-3xl font-medium tracking-tight sm:text-4xl">Poids</h1>
			<p class="mt-2 text-muted-foreground">
				Note tes pesées et suis ta tendance.
			</p>
		</div>
		<nav
			aria-label="Période affichée"
			class={cn(segmentedControlVariants(), 'w-full sm:w-auto')}
		>
			{
				WEIGHT_PERIOD_OPTIONS.map(option => (
					<a
						href={`${ROUTES.weight}?period=${option.value}`}
						aria-current={option.value === period ? 'page' : undefined}
						class={segmentedControlItemVariants()}
					>
						{option.label}
					</a>
				))
			}
		</nav>
	</div>
	<div
		class="grid gap-3 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:items-start lg:gap-4"
	>
		<div class="lg:sticky lg:top-6">
			<WeightEntryForm
				client:load
				units={units}
				todayWeightDisplay={todayWeightDisplay}
			/>
		</div>
		<div class="grid gap-3 lg:gap-4">
			<WeightTrendChart entries={displayEntries} unitLabel={unitLabel} />
			<WeightHistory entries={displayEntries} unitLabel={unitLabel} />
		</div>
	</div>
</AppLayout>
