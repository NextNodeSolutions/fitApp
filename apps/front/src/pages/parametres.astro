---
import { env } from 'cloudflare:workers'

import { CardDescription, CardTitle, cardVariants } from '@fitapp/ui'

import { LogoutButton } from '../features/auth/LogoutButton'
import ProfileMissingCard from '../features/onboarding/ProfileMissingCard.astro'
import { ApiTokenCard } from '../features/settings/ApiTokenCard'
import { DeleteAccountCard } from '../features/settings/DeleteAccountCard'
import { ProfilePatchForm } from '../features/settings/ProfilePatchForm'
import { UnitsToggle } from '../features/settings/UnitsToggle'
import { fetchSettingsProfile } from '../features/settings/fetch-settings-profile'
import { fetchSettingsToken } from '../features/settings/fetch-settings-token'
import AppLayout from '../layouts/AppLayout.astro'

const { user } = Astro.locals
const cookie = Astro.request.headers.get('cookie')
const [token, profile] = await Promise.all([
	fetchSettingsToken(env, cookie),
	fetchSettingsProfile(env, cookie),
])
---

<AppLayout title="Réglages" current="settings">
	<h1
		class="mb-6 text-3xl font-medium tracking-tight sm:mb-8 sm:text-4xl"
	>
		Réglages
	</h1>
	<div class="grid gap-3 lg:grid-cols-2 lg:items-start lg:gap-4">
		{
			profile ? (
				<ProfilePatchForm client:load profile={profile} />
			) : (
				<ProfileMissingCard title="Profil" />
			)
		}
		<div class="grid gap-3 lg:gap-4">
			{profile ? <UnitsToggle client:load units={profile.units} /> : null}
			<ApiTokenCard client:load token={token} />
			<section class={cardVariants()}>
				<CardTitle>Compte</CardTitle>
				{
					user ? (
						<CardDescription className="mt-1 wrap-anywhere">
							Connecté avec {user.email}
						</CardDescription>
					) : null
				}
				<div class="mt-4">
					<LogoutButton client:load />
				</div>
				<div class="mt-6 border-t border-secondary pt-6">
					<DeleteAccountCard client:load />
				</div>
			</section>
		</div>
	</div>
</AppLayout>
