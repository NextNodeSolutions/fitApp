---
import '../styles.css'

import { LogoutButton } from '../features/auth/LogoutButton'

const { user } = Astro.locals
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Tableau de bord — fitApp</title>
	</head>
	<body class="min-h-screen bg-gray-950 text-white">
		<div class="mx-auto max-w-lg px-4 py-12">
			<div class="mb-8 text-center">
				<h1 class="text-3xl font-bold text-lime-400">fitApp</h1>
				<p class="mt-2 text-gray-400">
					Bienvenue {user?.name ?? 'sur ton tableau de bord'} !
				</p>
			</div>
			<div class="rounded-lg border border-gray-700 bg-gray-900 p-6 text-center">
				<p class="text-gray-300">
					Bienvenue dans ton suivi personnalisé.
				</p>
				<p class="mt-2 text-sm text-gray-500">
					Les fonctionnalités arrivent bientôt.
				</p>
			</div>
			<div class="mt-6 flex justify-center">
				<LogoutButton client:load />
			</div>
		</div>
	</body>
</html>
