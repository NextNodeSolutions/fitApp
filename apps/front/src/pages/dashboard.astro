---
import { env } from 'cloudflare:workers'

import {
	buildDaySummary,
	computeDailyCalorieTarget,
	todayIsoDate,
	weightUnitLabel,
} from '@fitapp/contracts'

import AssistantCard from '../features/dashboard/AssistantCard.astro'
import { buildWeekDays } from '../features/dashboard/build-week-days'
import CaloriesCard from '../features/dashboard/CaloriesCard.astro'
import DayHeading from '../features/dashboard/DayHeading.astro'
import DayPicker from '../features/dashboard/DayPicker.astro'
import { loadDashboardData } from '../features/dashboard/load-dashboard-data'
import MacrosCard from '../features/dashboard/MacrosCard.astro'
import MealsCard from '../features/dashboard/MealsCard.astro'
import { resolveDashboardDate } from '../features/dashboard/resolve-dashboard-date'
import WeightCard from '../features/dashboard/WeightCard.astro'
import ProfileMissingCard from '../features/onboarding/ProfileMissingCard.astro'
import { toDisplayWeightEntries } from '../features/weight/to-display-weight-entries'
import AppLayout from '../layouts/AppLayout.astro'

const today = todayIsoDate()
const date = resolveDashboardDate(Astro.url.searchParams.get('date'), today)
const { profile, weekMeals, weights, week } = await loadDashboardData(
	env,
	Astro.locals.user?.id ?? null,
	date,
)
const dayMeals = weekMeals.filter(meal => meal.entryDate === date)
const weightKg = weights[0]?.weightKg ?? profile?.weight
const summary =
	profile && weightKg
		? buildDaySummary(
				computeDailyCalorieTarget(profile, weightKg),
				weightKg,
				dayMeals,
			)
		: null
const days = buildWeekDays({
	week,
	weekMeals,
	targetKcal: summary?.targetKcal ?? 0,
	selected: date,
	today,
})
const units = profile?.units ?? 'metric'
---

<AppLayout title="Aujourd'hui" current="today">
	<DayHeading date={date} today={today} mealCount={dayMeals.length} />
	<DayPicker days={days} />
	{
		summary ? (
			<div class="mt-5 grid gap-3 lg:grid-cols-[1.1fr_1fr] lg:items-start lg:gap-4">
				<div class="grid gap-3 lg:gap-4">
					<CaloriesCard summary={summary} />
					<MacrosCard macros={summary.macros} />
				</div>
				<div class="grid gap-3 lg:gap-4">
					<MealsCard meals={dayMeals} />
					<WeightCard
							entries={toDisplayWeightEntries(weights, units)}
							unitLabel={weightUnitLabel(units)}
						/>
					<AssistantCard hasMealsThisWeek={weekMeals.length > 0} />
				</div>
			</div>
		) : (
			<ProfileMissingCard title="Il manque ton profil" class="mt-6" />
		)
	}
</AppLayout>
